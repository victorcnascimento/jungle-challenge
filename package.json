{
  "name": "jungle-wagering-processor",
  "version": "1.0.0",
  "description": "Distributed Wagering Processor — Jungle Gaming Technical Challenge",
  "private": true,
  "scripts": {
    "build": "bun build src/main.ts --outdir dist --target bun",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "migration:up": "bun run src/infrastructure/database/cli-migrate.ts up",
    "migration:down": "bun run src/infrastructure/database/cli-migrate.ts down",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun run test/load/load-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.600.0",
    "@mikro-orm/core": "^6.3.0",
    "@mikro-orm/migrations": "^6.3.0",
    "@mikro-orm/nestjs": "^6.0.2",
    "@mikro-orm/postgresql": "^6.3.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.4.3",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@nestjs/testing": "^10.4.0",
    "@types/bun": "latest",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.6",
    "pg-gateway": "^0.3.0-beta.4",
    "typescript": "^5.5.4"
  }
}
